    ],
    "type": "quiz",
    "is_anonymous": true,
    "correct_option_id": 0,
    "explanation": "\"You and Malika\" deb so'rashsa, javob \"we\" bilan. Qisqa \"Yes\" javobda qisqartma ishlatilmaydi: Yes, we are. \"Yes, we're\" xato."
   }
  },
  {
   "method": "sendPoll",
