{"id": "20261130", "title": "Matematika: amallar, kasrlar va geometriya", "opens": "2026-11-29 20:00", "closes": "2026-11-30 20:00", "limit_min": 15, "questions": [{"q": "48 : 6 + 2 × 5 = ?", "o": ["50", "18", "26", "13"], "c": 1, "e": "Avval bo‘lish va ko‘paytirish: 48 : 6 = 8, 2 × 5 = 10, keyin 8 + 10 = 18."}, {"q": "XIV Rim raqami qaysi songa teng?", "o": ["16", "9", "14", "19"], "c": 2, "e": "X = 10, IV = 4, jami 14."}, {"q": "1 kg necha grammga teng?", "o": ["100", "10", "10000", "1000"], "c": 3, "e": "1 kg = 1000 g."}, {"q": "Qaysi son 9 ga bo‘linadi?", "o": ["3456", "1234", "5672", "4441"], "c": 0, "e": "Raqamlar yig‘indisi 9 ga bo‘linsa, son ham bo‘linadi: 3+4+5+6 = 18."}, {"q": "2/5 + 1/5 = ?", "o": ["3/10", "3/5", "2/25", "1/5"], "c": 1, "e": "Maxrajlar bir xil: suratlar qo‘shiladi, maxraj o‘zgarmaydi — 3/5."}, {"q": "EKUB(12; 18) = ?", "o": ["3", "6", "36", "2"], "c": 1, "e": "12 va 18 ning eng katta umumiy bo‘luvchisi — 6."}, {"q": "3,6 × 10 = ?", "o": ["0,36", "3,60", "36", "360"], "c": 2, "e": "10 ga ko‘paytirishda vergul bir xona o‘ngga suriladi: 36."}, {"q": "37 ni 5 ga bo‘lganda qoldiq nechaga teng?", "o": ["7", "3", "5", "2"], "c": 3, "e": "37 = 5 × 7 + 2, qoldiq 2."}, {"q": "Uchburchak burchaklarining yig‘indisi nechaga teng?", "o": ["90°", "180°", "270°", "360°"], "c": 1, "e": "Har qanday uchburchakda burchaklar yig‘indisi 180°."}, {"q": "2³ = ?", "o": ["6", "5", "8", "9"], "c": 2, "e": "2³ = 2 × 2 × 2 = 8."}]}