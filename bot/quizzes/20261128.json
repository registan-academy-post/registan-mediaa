{"id": "20261128", "title": "Rus tili: oila, kasblar va savol so‘zlari", "opens": "2026-11-28 19:30", "closes": "2026-11-29 19:30", "limit_min": 15, "point": 2.5, "topics": "oila a’zolari, kasblar, ovqat va ichimliklar, savol so‘zlari (Кто, Где, Что), predloglar В / НА, o‘tgan zamon (был, была), sifat va ot moslashuvi", "questions": [{"q": "«Ota» ruschada qanday?", "o": ["мать", "отец", "брат", "сестра"], "c": 1, "e": "Отец — ota. Мать — ona, брат — aka-uka, сестра — opa-singil."}, {"q": "«Opa-singil» ruschada qanday?", "o": ["брат", "дочь", "сестра", "сын"], "c": 2, "e": "Сестра — opa-singil. Дочь — qiz (farzand), сын — o‘g‘il."}, {"q": "«Non» ruschada qanday?", "o": ["молоко", "вода", "мясо", "хлеб"], "c": 3, "e": "Хлеб — non. Молоко — sut, мясо — go‘sht."}, {"q": "«Suv» ruschada qanday?", "o": ["вода", "сок", "чай", "суп"], "c": 0, "e": "Вода — suv. Сок — sharbat, суп — sho‘rva."}, {"q": "___ это? — Это мой друг.", "o": ["Что", "Где", "Кто", "Когда"], "c": 2, "e": "Odam haqida so‘ralganda «Кто?» (Kim?) ishlatiladi."}, {"q": "___ ты живёшь? — В Ташкенте.", "o": ["Кто", "Где", "Что", "Сколько"], "c": 1, "e": "Joy haqida so‘ralganda «Где?» (Qayerda?)."}, {"q": "Я живу ___ Ташкенте.", "o": ["на", "к", "в", "с"], "c": 2, "e": "Shahar ichida: «в Ташкенте»."}, {"q": "Книга лежит ___ столе.", "o": ["в", "под", "из", "на"], "c": 3, "e": "Narsa ustida bo‘lsa «на»: на столе — stol ustida."}, {"q": "Вчера он ___ дома.", "o": ["был", "была", "было", "были"], "c": 0, "e": "«Он» bilan o‘tgan zamon: был."}, {"q": "Вчера она ___ в школе.", "o": ["был", "была", "было", "были"], "c": 1, "e": "«Она» bilan o‘tgan zamon: была."}, {"q": "«Shifokor» ruschada qanday?", "o": ["учитель", "повар", "врач", "водитель"], "c": 2, "e": "Врач — shifokor. Учитель — o‘qituvchi, повар — oshpaz, водитель — haydovchi."}, {"q": "«O‘qituvchi» ruschada qanday?", "o": ["учитель", "ученик", "врач", "продавец"], "c": 0, "e": "Учитель — o‘qituvchi. Ученик — o‘quvchi, продавец — sotuvchi."}, {"q": "«Ertaga» ruschada qanday?", "o": ["вчера", "сегодня", "завтра", "сейчас"], "c": 2, "e": "Завтра — ertaga. Вчера — kecha, сегодня — bugun, сейчас — hozir."}, {"q": "Мы ___ в школу.", "o": ["иду", "идёт", "идут", "идём"], "c": 3, "e": "«Мы» bilan: мы идём — biz boryapmiz."}, {"q": "«Katta uy» ruschada qanday?", "o": ["большой дом", "большая дом", "большое дом", "большие дом"], "c": 0, "e": "«Дом» erkak jinsida, sifat ham erkak jinsida: большой дом."}]}